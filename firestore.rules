rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Administración operativa de TruchiCount. Este bypass es intencional:
    // permite recuperar, crear y administrar cualquier Count sin depender de
    // que la primera membership del batch ya exista.
    function isSuperAdmin() {
      return signedIn()
        && request.auth.token.email == "garcialeonel1990@gmail.com";
    }

    function membershipPath(countId, uid) {
      return /databases/$(database)/documents/memberships/$(countId + "_" + uid);
    }

    function isCountMember(countId) {
      return signedIn()
        && exists(membershipPath(countId, request.auth.uid))
        && get(membershipPath(countId, request.auth.uid)).data.status == "active";
    }

    function isCountMemberAfter(countId) {
      return signedIn()
        && existsAfter(membershipPath(countId, request.auth.uid))
        && getAfter(membershipPath(countId, request.auth.uid)).data.status == "active";
    }

    function isActiveCount(countId) {
      return exists(/databases/$(database)/documents/counts/$(countId))
        && get(/databases/$(database)/documents/counts/$(countId)).data.status == "active";
    }

    function isActiveCountAfter(countId) {
      return existsAfter(/databases/$(database)/documents/counts/$(countId))
        && getAfter(/databases/$(database)/documents/counts/$(countId)).data.status == "active";
    }

    function isActiveCountMember(countId) {
      return isCountMember(countId) && isActiveCount(countId);
    }

    function isActiveCountMemberAfter(countId) {
      return isCountMemberAfter(countId) && isActiveCountAfter(countId);
    }

    function isOwner(countId) {
      return isCountMember(countId)
        && get(/databases/$(database)/documents/counts/$(countId)).data.ownerUid == request.auth.uid;
    }

    function hasActiveInvite(token, countId) {
      return token is string
        && exists(/databases/$(database)/documents/invites/$(token))
        && get(/databases/$(database)/documents/invites/$(token)).data.countId == countId
        && get(/databases/$(database)/documents/invites/$(token)).data.status == "active"
        && isActiveCount(countId);
    }

    match /users/{uid} {
      allow create, read, update: if isSuperAdmin()
        || (signedIn() && request.auth.uid == uid);
      allow delete: if isSuperAdmin();
    }

    match /counts/{countId} {
      allow create: if isSuperAdmin()
        || (signedIn() && request.resource.data.ownerUid == request.auth.uid);
      allow read: if isSuperAdmin() || isCountMember(countId);
      // Cualquier integrante puede alternar el archivado. Fuera de esa
      // transición el Count no admite cambios desde el cliente.
      allow update: if isSuperAdmin() || (isCountMember(countId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "archiveBalanceSnapshot", "firstArchivedAt", "firstArchivedBy",
          "lastArchivedAt", "lastArchivedBy", "lastArchivedByNameSnapshot",
          "lastUnarchivedAt", "lastUnarchivedBy", "lastUnarchivedByNameSnapshot",
          "updatedAt", "updatedBy"
        ])
        && ((resource.data.status == "active" && request.resource.data.status == "archived")
          || (resource.data.status == "archived" && request.resource.data.status == "active")));
      allow delete: if isSuperAdmin();

      match /expenses/{expenseId} {
        allow read: if isSuperAdmin() || isCountMember(countId);
        allow create, update: if isSuperAdmin() || isActiveCountMember(countId);
        allow delete: if isSuperAdmin();
      }

      match /settlements/{settlementId} {
        allow read: if isSuperAdmin() || isCountMember(countId);
        allow create, update: if isSuperAdmin() || isActiveCountMember(countId);
        allow delete: if isSuperAdmin();
      }
    }

    match /memberships/{membershipId} {
      allow read: if isSuperAdmin() || (signedIn() && (
        resource.data.uid == request.auth.uid || isCountMember(resource.data.countId)
      ));
      allow create: if isSuperAdmin() || (signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "active"
        && (
          (getAfter(/databases/$(database)/documents/counts/$(request.resource.data.countId)).data.ownerUid == request.auth.uid
            && request.resource.data.role == "owner")
          || hasActiveInvite(request.resource.data.inviteToken, request.resource.data.countId)
        ));
      allow update: if isSuperAdmin()
        || (isOwner(resource.data.countId)
          && isActiveCount(resource.data.countId)
          && resource.data.role != "owner"
          && resource.data.status == "active"
          && request.resource.data.status == "inactive"
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "removedAt", "removedBy", "updatedAt", "updatedBy"])
          && request.resource.data.removedBy == request.auth.uid)
        || (signedIn()
          && resource.data.uid == request.auth.uid
          && resource.data.status == "inactive"
          && request.resource.data.status == "active"
          && isActiveCount(resource.data.countId)
          && hasActiveInvite(request.resource.data.inviteToken, resource.data.countId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "joinedAt", "joinedByInvite", "inviteToken", "removedAt", "removedBy", "updatedAt", "updatedBy"]));
      allow delete: if isSuperAdmin();
    }

    match /invites/{token} {
      allow read: if isSuperAdmin() || signedIn();
      allow create: if isSuperAdmin() || (signedIn() && isActiveCountMember(request.resource.data.countId)
        && request.resource.data.createdBy == request.auth.uid);
      allow update: if isSuperAdmin() || (signedIn()
        && isActiveCount(resource.data.countId)
        && resource.data.status == "active"
        && request.resource.data.countId == resource.data.countId
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["usageCount", "lastUsedAt"]));
      allow delete: if isSuperAdmin();
    }

    match /categories/{categoryId} {
      allow read: if isSuperAdmin() || signedIn();
      allow create: if isSuperAdmin() || (signedIn() && request.resource.data.createdBy == request.auth.uid);
      allow update: if isSuperAdmin() || signedIn();
      allow delete: if isSuperAdmin();
    }

    match /merchants/{merchantId} {
      allow read: if isSuperAdmin() || signedIn();
      allow create: if isSuperAdmin() || (signedIn() && request.resource.data.createdBy == request.auth.uid);
      allow update: if isSuperAdmin() || signedIn();
      allow delete: if isSuperAdmin();
    }

    match /auditLogs/{auditId} {
      allow read: if isSuperAdmin() || (signedIn() && isCountMember(resource.data.countId));
      allow create: if isSuperAdmin() || (signedIn()
        && request.resource.data.actorUid == request.auth.uid
        && (
          request.resource.data.entityType == "category"
          || isActiveCountMember(request.resource.data.countId)
          || (isActiveCountMemberAfter(request.resource.data.countId)
            && request.resource.data.entityType == "count"
            && request.resource.data.action == "create")
          || (isCountMember(request.resource.data.countId)
            && request.resource.data.entityType == "count"
            && request.resource.data.action == "unarchiveCount"
            && isActiveCountAfter(request.resource.data.countId))
        ));
      allow update, delete: if isSuperAdmin();
    }
  }
}
