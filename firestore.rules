rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // La fuente real de seguridad administrativa es el UID de Firebase Auth.
    function isAdmin() {
      return signedIn()
        && request.auth.uid == "8qvbKFXafDXWWGDPo2OFDul6uss1";
    }

    function isApprovedUser() {
      return isAdmin() || (signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accessStatus == "approved");
    }

    function membershipPath(countId, uid) {
      return /databases/$(database)/documents/memberships/$(countId + "_" + uid);
    }

    // A first invitation needs to read its own membership document even when
    // it does not exist yet. Restrict that read to the canonical id instead
    // of opening arbitrary membership documents to approved users.
    function isOwnMembershipPath(membershipId) {
      return signedIn() && membershipId.matches("^.+_" + request.auth.uid + "$");
    }

    function isCountMember(countId) {
      return isApprovedUser()
        && exists(membershipPath(countId, request.auth.uid))
        && get(membershipPath(countId, request.auth.uid)).data.status == "active";
    }

    function isCountMemberAfter(countId) {
      return isApprovedUser()
        && existsAfter(membershipPath(countId, request.auth.uid))
        && getAfter(membershipPath(countId, request.auth.uid)).data.status == "active";
    }

    function isActiveCount(countId) {
      return exists(/databases/$(database)/documents/counts/$(countId))
        && get(/databases/$(database)/documents/counts/$(countId)).data.status == "active";
    }

    function isActiveCountAfter(countId) {
      return existsAfter(/databases/$(database)/documents/counts/$(countId))
        && getAfter(/databases/$(database)/documents/counts/$(countId)).data.status == "active";
    }

    function isActiveCountMember(countId) {
      return isCountMember(countId) && isActiveCount(countId);
    }

    function isActiveCountMemberAfter(countId) {
      return isCountMemberAfter(countId) && isActiveCountAfter(countId);
    }

    function isDraftOwner(countId) {
      return isApprovedUser()
        && exists(/databases/$(database)/documents/counts/$(countId))
        && get(/databases/$(database)/documents/counts/$(countId)).data.status == "draft"
        && get(/databases/$(database)/documents/counts/$(countId)).data.createdBy == request.auth.uid;
    }

    function isDraftOwnerAfter(countId) {
      return isApprovedUser()
        && existsAfter(/databases/$(database)/documents/counts/$(countId))
        && getAfter(/databases/$(database)/documents/counts/$(countId)).data.status == "draft"
        && getAfter(/databases/$(database)/documents/counts/$(countId)).data.createdBy == request.auth.uid;
    }

    function isDraftInviteActivatedAfter(countId, token) {
      return token is string
        && existsAfter(/databases/$(database)/documents/invites/$(token))
        && getAfter(/databases/$(database)/documents/invites/$(token)).data.countId == countId
        && getAfter(/databases/$(database)/documents/invites/$(token)).data.status == "active";
    }

    function isOwner(countId) {
      // Todos los integrantes registrados activos administran el Count.
      return isCountMember(countId);
    }

    function hasActiveInvite(token, countId) {
      return token is string
        && exists(/databases/$(database)/documents/invites/$(token))
        && get(/databases/$(database)/documents/invites/$(token)).data.countId == countId
        && get(/databases/$(database)/documents/invites/$(token)).data.status == "active"
        && isActiveCount(countId);
    }

    function isSupportedCurrency(currency) {
      return currency is string && currency in currencyCodes();
    }

    function currencyCodes() {
      return ["AED", "AFN", "ALL", "AMD", "AOA", "ARS", "AUD", "AWG", "AZN", "BAM", "BBD", "BDT", "BGN", "BHD", "BIF", "BMD", "BND", "BOB", "BRL", "BSD", "BTN", "BWP", "BYN", "BZD", "CAD", "CDF", "CHF", "CLP", "CNY", "COP", "CRC", "CUP", "CVE", "CZK", "DJF", "DKK", "DOP", "DZD", "EGP", "ERN", "ETB", "EUR", "FJD", "FKP", "GBP", "GEL", "GHS", "GIP", "GMD", "GNF", "GTQ", "GYD", "HKD", "HNL", "HTG", "HUF", "IDR", "ILS", "INR", "IQD", "IRR", "ISK", "JMD", "JOD", "JPY", "KES", "KGS", "KHR", "KMF", "KPW", "KRW", "KWD", "KYD", "KZT", "LAK", "LBP", "LKR", "LRD", "LSL", "LYD", "MAD", "MDL", "MGA", "MKD", "MMK", "MNT", "MOP", "MRU", "MUR", "MVR", "MWK", "MXN", "MYR", "MZN", "NAD", "NGN", "NIO", "NOK", "NPR", "NZD", "OMR", "PAB", "PEN", "PGK", "PHP", "PKR", "PLN", "PYG", "QAR", "RON", "RSD", "RUB", "RWF", "SAR", "SBD", "SCR", "SDG", "SEK", "SGD", "SHP", "SLE", "SOS", "SRD", "SSP", "STN", "SVC", "SYP", "SZL", "THB", "TJS", "TMT", "TND", "TOP", "TRY", "TTD", "TWD", "TZS", "UAH", "UGX", "USD", "UYU", "UZS", "VES", "VND", "VUV", "WST", "XAF", "XCD", "XCG", "XOF", "XPF", "YER", "ZAR", "ZMW", "ZWG"];
    }

    match /users/{uid} {
      // Los perfiles contienen email y estado de acceso; un integrante ve su
      // propio perfil, mientras los aliases compartidos viven como snapshots
      // dentro de cada Member.
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if (isAdmin()
          && uid == "8qvbKFXafDXWWGDPo2OFDul6uss1"
          && request.resource.data.uid == uid
          && request.resource.data.accessStatus == "approved"
          && request.resource.data.isAdmin == true)
        || (signedIn()
          && request.auth.uid == uid
          && uid != "8qvbKFXafDXWWGDPo2OFDul6uss1"
          && request.resource.data.uid == uid
          && request.resource.data.accessStatus == "pending"
          && request.resource.data.isAdmin == false);
      allow update: if (isAdmin()
          && (uid != "8qvbKFXafDXWWGDPo2OFDul6uss1"
            || (request.resource.data.accessStatus == "approved"
              && request.resource.data.isAdmin == true)))
        || (signedIn()
          && request.auth.uid == uid
          && uid != "8qvbKFXafDXWWGDPo2OFDul6uss1"
          && request.resource.data.uid == uid
          && request.resource.data.isAdmin == false
          && (!request.resource.data.keys().hasAny(["enabledCurrencies"])
            || (request.resource.data.enabledCurrencies is list
              && request.resource.data.enabledCurrencies.size() >= 1
              && request.resource.data.enabledCurrencies.size() <= 20
              && request.resource.data.enabledCurrencies.hasOnly(currencyCodes())))
          && (!request.resource.data.keys().hasAny(["defaultCurrency"])
            || request.resource.data.defaultCurrency == null
            || isSupportedCurrency(request.resource.data.defaultCurrency))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "uid", "googleDisplayName", "email", "alias", "accessStatus", "isAdmin",
            "requestedAt", "lastLoginAttemptAt", "updatedAt", "defaultCurrency",
            "draftCountId", "draftExpiresAt",
            "enabledCurrencies"
          ])
          && ((!resource.data.keys().hasAll(["accessStatus"])
              && request.resource.data.accessStatus == "pending")
            || request.resource.data.accessStatus == resource.data.accessStatus));
      // El administrador puede quitar un perfil sin historial para que la
      // próxima autenticación vuelva a crear una solicitud pendiente.
      allow delete: if isAdmin();
    }

    match /counts/{countId} {
      function validEmoji(data) {
        return !data.keys().hasAny(["emoji"])
          || (data.emoji is string && data.emoji.size() > 0 && data.emoji.size() <= 32 && data.emoji.matches('^[^<>&"=]+$'));
      }
      allow create: if isAdmin()
        || (isApprovedUser()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == "draft"
          && (request.resource.data.primaryCurrency == null || isSupportedCurrency(request.resource.data.primaryCurrency))
          && validEmoji(request.resource.data));
      allow read: if isAdmin() || isCountMember(countId);
      allow update: if isAdmin()
        || (isDraftOwner(countId)
          && request.resource.data.status == "draft"
          && (request.resource.data.primaryCurrency == null || isSupportedCurrency(request.resource.data.primaryCurrency))
          && validEmoji(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "name", "normalizedName", "emoji", "primaryCurrency", "defaultCurrency",
            "updatedAt", "updatedBy", "draftExpiresAt"
          ]))
        || (isDraftOwner(countId)
          && request.resource.data.status == "active"
          && (request.resource.data.primaryCurrency == null || isSupportedCurrency(request.resource.data.primaryCurrency))
          && isDraftInviteActivatedAfter(countId, resource.data.draftInviteToken)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "name", "normalizedName", "primaryCurrency", "defaultCurrency", "status",
            "activatedAt", "updatedAt", "updatedBy", "draftExpiresAt"
          ]))
        ;
      allow delete: if isAdmin() || isDraftOwner(countId);

      match /expenses/{expenseId} {
        allow read: if isAdmin() || isCountMember(countId);
        allow write: if false;
      }

      match /settlements/{settlementId} {
        allow read: if isAdmin() || isCountMember(countId);
        // Sólo el backend privilegiado puede modificar liquidaciones.
        allow write: if false;
      }

      match /members/{memberId} {
        // Un invitado aprobado puede resolver únicamente un Member conocido
        // desde su invite; el listado completo sigue siendo privado del Count.
        allow get: if isAdmin() || isCountMember(countId) || (isApprovedUser() && (memberId == "registered_" + request.auth.uid || resource == null || resource.data.userId == request.auth.uid || (resource.data.type == "manual" && resource.data.active == true && resource.data.userId == null)));
        allow list: if isAdmin() || isCountMember(countId);
        // Los manuales no poseen Auth; sólo un integrante registrado puede
        // crearlos. Los registrados llegan exclusivamente por una invitación.
        allow create: if isAdmin() || (
          (isActiveCountMember(countId)
            || (isActiveCountAfter(countId) && isCountMemberAfter(countId)))
          && request.resource.data.countId == countId
          && request.resource.data.active == true
          && request.resource.data.createdBy == request.auth.uid
          && (
            (request.resource.data.type == "manual"
              && request.resource.data.userId == null
              && request.resource.data.role == "member")
            || (request.resource.data.type == "registered"
              && request.resource.data.userId == request.auth.uid
              && request.resource.data.role == "owner"
              && (getAfter(/databases/$(database)/documents/counts/$(countId)).data.ownerUid == request.auth.uid
                || hasActiveInvite(request.resource.data.inviteToken, countId)))
          )
        ) || (isDraftOwnerAfter(countId)
          && request.resource.data.countId == countId
          && request.resource.data.active == true
          && request.resource.data.createdBy == request.auth.uid
          && ((request.resource.data.type == "registered"
              && request.resource.data.userId == request.auth.uid
              && request.resource.data.role == "owner")
            || (request.resource.data.type == "manual"
              && request.resource.data.userId == null
              && request.resource.data.role == "member")));
        allow update: if isAdmin()
          // Edición y baja de un Member activo por un integrante registrado.
          || (isActiveCountMember(countId)
            && resource.data.active == true
            && ((resource.data.type == "manual"
                && request.resource.data.type == "manual"
                && request.resource.data.userId == null
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  "alias", "normalizedAlias", "manualAlias", "normalizedManualAlias",
                  "updatedAt", "updatedBy"
                ]))
              ))
          // Reactivación de un manual por un integrante registrado.
          || (signedIn()
            && isActiveCountMember(countId)
            && resource.data.type == "manual"
            && resource.data.active == false
            && request.resource.data.active == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "alias", "normalizedAlias", "manualAlias", "normalizedManualAlias",
              "active", "reactivatedAt", "reactivatedBy",
              "removedAt", "removedBy", "updatedAt", "updatedBy"
            ]))
          // Reactivación de un registrado solamente mediante invitación válida.
          || (isApprovedUser()
            && resource.data.type == "registered"
            && resource.data.userId == request.auth.uid
            && resource.data.active == false
            && request.resource.data.active == true
            && isActiveCount(countId)
            && hasActiveInvite(request.resource.data.inviteToken, countId))
          || (isDraftOwner(countId)
            && resource.data.type == "manual"
            && request.resource.data.type == "manual"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "alias", "normalizedAlias", "manualAlias", "normalizedManualAlias",
              "updatedAt", "updatedBy"
            ]))
          // Un invitado aprobado puede reclamar un manual elegible, pero debe
          // crear su membership en la misma transacción.
          || (isApprovedUser()
            && resource.data.type == "manual"
            && resource.data.active == true
            && resource.data.userId == null
            && request.resource.data.type == "registered"
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.role == "owner"
            && hasActiveInvite(request.resource.data.inviteToken, countId)
            && existsAfter(membershipPath(countId, request.auth.uid))
            && getAfter(membershipPath(countId, request.auth.uid)).data.memberId == memberId
            && getAfter(membershipPath(countId, request.auth.uid)).data.status == "active"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "type", "userId", "alias", "aliasSnapshot", "role", "previousManualAlias", "inviteToken",
              "linkedAt", "linkedByUid", "updatedAt", "updatedBy"
            ]));
        allow delete: if isAdmin() || (isDraftOwner(countId)
            && (resource.data.type == "manual"
              || !existsAfter(/databases/$(database)/documents/counts/$(countId))));
      }
    }

    match /memberships/{membershipId} {
      allow get: if isAdmin() || (isApprovedUser() && (
        isOwnMembershipPath(membershipId) || isCountMember(resource.data.countId)
      ));
      // La Home consulta memberships por uid. Autorizar sólo los documentos
      // cuyo uid sea el propio evita la condición circular de necesitar ser
      // miembro para poder descubrir la membresía, sin exponer las ajenas.
      allow list: if isAdmin() || (isApprovedUser() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin() || (isApprovedUser()
        && membershipId == request.resource.data.countId + "_" + request.resource.data.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "active"
        && existsAfter(/databases/$(database)/documents/counts/$(request.resource.data.countId)/members/$(request.resource.data.memberId))
        && getAfter(/databases/$(database)/documents/counts/$(request.resource.data.countId)/members/$(request.resource.data.memberId)).data.type == "registered"
        && getAfter(/databases/$(database)/documents/counts/$(request.resource.data.countId)/members/$(request.resource.data.memberId)).data.userId == request.auth.uid
        && getAfter(/databases/$(database)/documents/counts/$(request.resource.data.countId)/members/$(request.resource.data.memberId)).data.active == true
        && (
          (getAfter(/databases/$(database)/documents/counts/$(request.resource.data.countId)).data.ownerUid == request.auth.uid
            && request.resource.data.role == "owner")
          || hasActiveInvite(request.resource.data.inviteToken, request.resource.data.countId)
        ));
      allow update: if isAdmin()
        || (membershipId == resource.data.countId + "_" + resource.data.uid
          && membershipId == request.resource.data.countId + "_" + request.resource.data.uid
          && (isApprovedUser()
          && resource.data.uid == request.auth.uid
          && resource.data.status == "inactive"
          && request.resource.data.status == "active"
          && isActiveCount(resource.data.countId)
          && hasActiveInvite(request.resource.data.inviteToken, resource.data.countId)
          && existsAfter(/databases/$(database)/documents/counts/$(resource.data.countId)/members/$(request.resource.data.memberId))
          && getAfter(/databases/$(database)/documents/counts/$(resource.data.countId)/members/$(request.resource.data.memberId)).data.type == "registered"
          && getAfter(/databases/$(database)/documents/counts/$(resource.data.countId)/members/$(request.resource.data.memberId)).data.userId == request.auth.uid
          && getAfter(/databases/$(database)/documents/counts/$(resource.data.countId)/members/$(request.resource.data.memberId)).data.active == true
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["memberId", "role", "status", "joinedAt", "joinedByInvite", "inviteToken", "removedAt", "removedBy", "updatedAt", "updatedBy"])));
      allow delete: if isAdmin()
        || (isDraftOwner(resource.data.countId)
          && resource.data.uid == request.auth.uid
          && !existsAfter(/databases/$(database)/documents/counts/$(resource.data.countId)));
    }

    match /invites/{token} {
      // A known token can be resolved by an approved user, but invites cannot
      // be enumerated globally. Members may list only their own Count's links.
      allow get: if isAdmin() || isApprovedUser();
      allow list: if isAdmin() || (isApprovedUser() && isCountMember(resource.data.countId));
      allow create: if isAdmin() || (isApprovedUser() && isActiveCountMember(request.resource.data.countId)
        && request.resource.data.createdBy == request.auth.uid)
        || (isDraftOwnerAfter(request.resource.data.countId)
          && request.resource.data.status == "draft"
          && request.resource.data.createdBy == request.auth.uid);
      allow update: if isAdmin() || (isApprovedUser()
        && isActiveCount(resource.data.countId)
        && resource.data.status == "active"
        && request.resource.data.countId == resource.data.countId
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["usageCount", "lastUsedAt"]))
        || (isActiveCountMember(resource.data.countId)
          && resource.data.status == "active"
          && request.resource.data.countId == resource.data.countId
          && request.resource.data.status == resource.data.status
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["manualCandidates", "updatedAt"]))
        || (isDraftOwner(resource.data.countId)
          && resource.data.status == "draft"
          && request.resource.data.status == "active"
          && isActiveCountAfter(resource.data.countId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "activatedAt"]))
        || (isDraftOwner(resource.data.countId)
          && resource.data.status == "draft"
          && request.resource.data.status == "draft"
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["manualCandidates", "updatedAt"]));
      allow delete: if isAdmin()
        || (isDraftOwner(resource.data.countId)
          && !existsAfter(/databases/$(database)/documents/counts/$(resource.data.countId)));
    }

    match /countNames/{nameId} {
      allow get: if isAdmin() || isApprovedUser();
      allow list: if false;
      allow create: if isAdmin() || (isDraftOwner(request.resource.data.countId)
        && request.resource.data.createdBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/counts/$(request.resource.data.countId)).data.normalizedName == request.resource.data.normalizedName);
      allow update: if false;
      allow delete: if isAdmin() || isDraftOwner(resource.data.countId);
    }

    match /categories/{categoryId} {
      allow read: if isAdmin() || isApprovedUser();
      allow create: if isAdmin() || (isApprovedUser() && request.resource.data.createdBy == request.auth.uid);
      allow update: if isAdmin()
        || (isApprovedUser()
          && resource.data.createdBy == request.auth.uid
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedBy == request.auth.uid)
        || (isApprovedUser()
          && resource.data.status == "inactive"
          && request.resource.data.status == "active"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "emoji", "normalizedName", "status", "updatedAt", "updatedBy", "deletedAt", "deletedBy", "schemaVersion"]));
      allow delete: if isAdmin();
    }

    match /merchants/{merchantId} {
      allow read: if isAdmin() || isApprovedUser();
      allow create: if isAdmin() || (isApprovedUser() && request.resource.data.createdBy == request.auth.uid);
      allow update: if isAdmin() || (isApprovedUser() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastUsedAt", "usageCount"]));
      allow delete: if isAdmin();
    }

    match /auditLogs/{auditId} {
      allow read: if isAdmin() || (isApprovedUser() && isCountMember(resource.data.countId));
      allow create: if isAdmin()
        || (signedIn()
          && request.auth.uid == request.resource.data.actorUid
          && request.resource.data.entityType == "userAccess"
          && request.resource.data.entityId == request.auth.uid
          && request.resource.data.action == "requestAccess")
        || (isApprovedUser()
          && request.resource.data.actorUid == request.auth.uid
          && ((request.resource.data.entityType == "category"
              && request.resource.data.action in ["create", "update", "delete", "reactivate"]
              && getAfter(/databases/$(database)/documents/categories/$(request.resource.data.entityId)).data.updatedBy == request.auth.uid)
            || (request.resource.data.entityType == "member"
              && request.resource.data.action in ["createRegisteredMember", "manualLinkedToUser", "reactivateMember", "createManualMember", "updateManualMemberAlias"]
              && (isActiveCountMember(request.resource.data.countId) || isActiveCountMemberAfter(request.resource.data.countId)))
            || (request.resource.data.entityType == "count"
              && request.resource.data.action == "createCount"
              && isActiveCountMemberAfter(request.resource.data.countId))));
      allow update, delete: if isAdmin();
    }
  }
}
