{
  "name": "truchicount",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:emulator": "firebase emulators:exec --project demo-truchicount --only firestore \"node --test tests/integration/*.test.mjs\"",
    "test:all": "npm test && npm run test:emulator",
    "deploy:checked": "npm run test:all && firebase deploy --only firestore:rules,firestore:indexes,hosting"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-tools": "^14.0.0"
  }
}
