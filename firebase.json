{
  "hosting": {
    "public": ".",
    "rewrites": [
      {
        "source": "/j/**",
        "destination": "/index.html"
      }
    ],
    "ignore": [
      "firebase.json",
      "README.md",
      "AGENTS.md",
      ".agents/**",
      ".git/**",
      ".github/**",
      "tests/**",
      "package.json",
      "package-lock.json",
      "firestore.rules",
      "firestore.indexes.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    }
  }
}
