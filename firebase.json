{
  "hosting": {
    "public": ".",
    "rewrites": [
      {
        "source": "/j/**",
        "destination": "/index.html"
      }
    ],
    "ignore": [
      "firebase.json",
      "README.md",
      "AGENTS.md",
      ".agents/**",
      ".git/**",
      ".github/**",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
